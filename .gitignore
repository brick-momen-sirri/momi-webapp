# Dependencies
node_modules/
.pnpm-store/

# Build outputs
dist/
backend/dist/
.e2e-dist/
# Snapshots of the two dist folders above, taken before each deploy and kept on
# disk as rollback targets. No leading or interior slash, so this matches at any
# depth and covers backend/ as well as the repo root.
dist-prev-*/

# Environment and local secrets
.env
.env.*
!.env.example
*.local

# Runtime state and generated backend data
backend/data/

# Logs
*.log
*.err
*.err.log
*.out.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Test and tooling output
coverage/
playwright-report/
test-results/
.nyc_output/
.cache/
.vite/
.turbo/

# Hosting/tool state
.vercel/
.netlify/

# OS/editor files
.DS_Store
Thumbs.db
*.swp
*.swo
