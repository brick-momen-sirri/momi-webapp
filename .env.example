# Backend
PORT=3333
HOST=127.0.0.1

# Production frontend gateway. It serves the Vite dist directory on the LAN and
# proxies application /api traffic to the loopback-only backend. Do not point it
# at a public backend; operational API paths are intentionally blocked here.
# FRONTEND_HOST=0.0.0.0
# FRONTEND_PORT=8190
# FRONTEND_DIST_PATH=C:/Momi-Animation/dist
# FRONTEND_API_TARGET=http://127.0.0.1:3333

# Production generation backend. Use local_comfy only for local development.
GENERATION_BACKEND=runpod

# RunPod serverless ComfyUI worker. Do not commit real values.
RUNPOD_ENDPOINT_ID=your-runpod-endpoint-id
RUNPOD_API_KEY=your-runpod-api-key
# Required for dispatcher/api split so the acknowledged job ID is persisted
# immediately and can be resumed after dispatcher failover. Monolith defaults
# to the legacy synchronous endpoint when this is omitted.
RUNPOD_SUBMISSION_MODE=async
COMFY_ORG_API_KEY=your-comfy-org-api-key
# Still Images pods. Every Animation workflow only relays to an external provider
# API, so they all share RUNPOD_ENDPOINT_ID above. Still image presets execute
# locally on the GPU and each needs its own worker carrying its own model weights
# and custom nodes, so each gets its own endpoint. A preset with no endpoint set
# here is refused at dispatch rather than sent to the shared worker, where it
# would fail on its first loader node.
# RUNPOD_ENDPOINT_ID_GENERAL_ENHANCEMENT=your-general-enhancement-endpoint-id
# RUNPOD_ENDPOINT_ID_PRO_UPSCALER=your-pro-upscaler-endpoint-id
# RUNPOD_ENDPOINT_ID_FLUX_KLEIN_UPSCALER=your-flux-klein-upscaler-endpoint-id
# RUNPOD_ENDPOINT_ID_REFERENCE_GENERATOR=your-reference-generator-endpoint-id
# RUNPOD_ENDPOINT_ID_QWEN_EDIT=your-qwen-edit-endpoint-id
# Animation > Video Enhancer: the LTX 2.5 CQ Enhancer V2 worker
# (brick-momen-sirri/worker-comfyui-LTX-2.5, image worker-comfyui-ltx25-cq:cq-v2).
# Unset hides the section. Its input goes by URL only, so RUNPOD_INPUT_BASE_URL or
# the RUNPOD_INPUT_BUCKET_* settings below must be configured too. Each request
# carries its own execution timeout, because the endpoint's 10-minute default is
# shorter than a 2560x1440 / 121-frame run.
# RUNPOD_ENDPOINT_ID_VIDEO_ENHANCER=dfadob3rm5dg32
# RUNPOD_VIDEO_ENHANCER_EXECUTION_TIMEOUT_MS=1800000
RUNPOD_POLL_INTERVAL_MS=5000
RUNPOD_TIMEOUT_MS=2400000
RUNPOD_MAX_CONCURRENT_JOBS=10
# Logs RunPod endpoint URLs, status codes, job ids, and sanitized request bodies.
RUNPOD_DEBUG=false
JSON_BODY_LIMIT=15mb
MEDIA_UPLOAD_MAX_BYTES=1073741824
RUNPOD_OUTPUT_MAX_BYTES=1073741824
# Maximum size for downloaded RunPod text artifacts (prompts, captions). Default 1MiB.
# RUNPOD_TEXT_OUTPUT_MAX_BYTES=1048576
# How often to retry saving completed results that are still remote-only
# (their local persist failed). Default 10 minutes; set 0 to disable.
# RESULT_RECOVERY_INTERVAL_MS=600000
# Job persistence store. "json" (default) uses data/jobs.json; "sqlite" uses a
# SQLite DB (jobs and archived items are migrated from their .json files on
# first boot). Experimental.
# JOB_STORE_DRIVER=json
# JOBS_SQLITE_PATH=./data/jobs.sqlite
# JOBS_ARCHIVED_SQLITE_PATH=./data/archived-items.sqlite
# Process ownership for the web/worker split. Keep monolith until the topology
# flip; dispatcher/api roles require SQLite row-level writes.
# ROLE=monolith
# JOBS_ROW_LEVEL_WRITES=false
# PM2 rollout flags: migrate shared SQLite state under the monolith first, keep
# it enabled for topology rollback, then explicitly enable dispatcher:1 + api:N.
# MOMI_SHARED_STATE=false
# MOMI_TOPOLOGY_SPLIT=false
# MOMI_API_INSTANCES=2
# MOMI_DISPATCHER_PORT=3334
# Shared users/sessions/projects store plus derived media index. Required before
# ROLE=api/dispatcher; migrates JSON stores once and leaves them frozen.
# APP_STATE_DRIVER=json
# APP_STATE_SQLITE_PATH=./data/app-state.sqlite
# PROFILE_PICTURE_ROOT=./data/profile-pictures
# Stage D dispatcher coordination defaults. The dispatcher polls for API-created
# jobs, heartbeats its crash-safe SQLite lease, and checkpoints WAL passively.
# DISPATCHER_POLL_INTERVAL_MS=350
# DISPATCHER_LEASE_TTL_MS=15000
# DISPATCHER_LEASE_HEARTBEAT_MS=5000
# DISPATCHER_WAL_CHECKPOINT_MS=30000
# Observability: /metrics (Prometheus text) is always served on every role. The
# dispatch/queue watchdog logs [alert] lines on state transitions (dispatcher
# judges queue stalls; the lowest-id API worker watches for a dead dispatcher
# lease) and optionally POSTs each alert to a webhook. Empty URL = logs only.
# WATCHDOG_INTERVAL_MS=30000
# WATCHDOG_QUEUE_STALL_EVALS=4
# WATCHDOG_DISK_FREE_MIN_BYTES=5368709120
# WATCHDOG_MEMORY_HIGH_MIB=1275
# ALERT_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz
# ALERT_WEBHOOK_FORMAT=slack
# The ops surface (/metrics, /ops-dashboard, /api/health, /api/ops-config,
# /api/alerts/recent, /api/backup-status) sits above the session auth middleware
# because a Prometheus scraper has no session. It is therefore guarded
# separately: loopback callers are trusted, and remote callers must present
# OPS_ACCESS_TOKEN (Authorization: Bearer, X-Ops-Token, or ?token=). The default
# below -- no token, loopback trusted -- behaves like binding ops to localhost.
# Set a token to scrape or open the dashboard from another host.
# WARNING: a same-host reverse proxy or tunnel also arrives from 127.0.0.1. If
# one fronts this backend, set a token AND OPS_ALLOW_LOOPBACK=false.
# OPS_ACCESS_TOKEN=
# OPS_ALLOW_LOOPBACK=true

# Browser origins allowed to make credentialed cross-origin calls, comma
# separated and matched exactly (scheme://host[:port]). Usually empty: the
# frontend reaches the API through the Vite /api proxy, which is same-origin and
# never consults CORS. Loopback and private-LAN origins are allowed on any port
# regardless, which is what keeps localhost:8190, the LAN host and the credit
# portal working -- set CORS_ALLOW_PRIVATE_ORIGINS=false to require the explicit
# list only. The literal "*" restores the old reflect-any-origin behaviour and
# exists purely as an emergency rollback.
# CORS_ALLOWED_ORIGINS=https://momi.brickvisual.com
# CORS_ALLOW_PRIVATE_ORIGINS=true

# Failed sign-in throttling on /api/auth/login. Counted per IP and per
# identifier: maxAttempts failures inside windowMs locks that key out for
# lockoutMs, and a successful sign-in clears it. In-memory per process, so with
# api:N workers the effective ceiling is N x maxAttempts.
# LOGIN_RATE_LIMIT_MAX_ATTEMPTS=10
# LOGIN_RATE_LIMIT_WINDOW_MS=900000
# LOGIN_RATE_LIMIT_LOCKOUT_MS=900000
# SQLite disaster recovery: consistent hot snapshots (integrity-checked,
# rotated) of jobs/archived-items/app-state, taken via the SQLite online backup
# API so WAL-resident rows are never lost. Runs on the dispatcher/monolith only.
# This host has a single local volume, so BACKUP_AZURE_SAS_URL (a container SAS
# URL with write access) is what makes this real DR rather than a local-only
# safety net. Never commit the SAS URL; set it in the process environment.
# SQLITE_BACKUP_ENABLED=false
# SQLITE_BACKUP_INTERVAL_MS=3600000
# SQLITE_BACKUP_RETENTION_COUNT=48
# SQLITE_BACKUP_STAGING_DIR=./data/backups
# BACKUP_AZURE_SAS_URL=https://<account>.blob.core.windows.net/<container>?<sas>
# BACKUP_AZURE_PREFIX=momi-backend
# AZCOPY_PATH=azcopy
# Generated media under LOCAL_PROJECTS_ROOT is included in append-only offsite
# baseline/delta cycles whenever SQLite backup and its Azure leg are enabled.
# MEDIA_BACKUP_ENABLED=true
# Fallback for RunPod use with neither RUNPOD_INPUT_BASE_URL nor a
# RUNPOD_INPUT_BUCKET_* bucket configured (both are further down): oversized
# image inputs are resized/re-encoded before inline JSON submission.
RUNPOD_INLINE_IMAGE_AUTO_COMPRESS=true
RUNPOD_INLINE_IMAGE_MAX_DIMENSION=4096
RUNPOD_INLINE_IMAGE_MIN_QUALITY=55
# The same fallback for video. Re-encodes at a lower bitrate and never changes
# resolution, because the provider's own dimension limits are already applied by
# the video preprocess step. Set to false to restore hard failures instead.
RUNPOD_INLINE_VIDEO_AUTO_COMPRESS=true
# Bitrate floor for that re-encode; below it the job fails rather than sending a
# badly degraded clip to a paid provider run.
RUNPOD_INLINE_VIDEO_MIN_BITRATE=400000
MEDIA_SCAN_CACHE_MS=60000
# Dispatcher refresh cadence for the shared existing-media index.
# MEDIA_INDEX_REFRESH_MS=500
MEMORY_LOG_INTERVAL_MS=15000
# Public HTTPS URL for this backend, used to send RunPod original-quality media
# as signed download links instead of oversized base64 JSON bodies.
# Examples: https://api.yourdomain.com or a Cloudflare/ngrok tunnel.
# RUNPOD_INPUT_BASE_URL=https://your-public-backend.example.com
# RUNPOD_INPUT_URL_SECRET=optional-separate-signing-secret

# RunPod inputs via object storage -- the same result as RUNPOD_INPUT_BASE_URL
# above, without exposing this host to the internet. Inputs are uploaded to an
# S3-compatible bucket and the worker is handed a presigned GET, which it
# downloads itself. That removes the request-body cap from media inputs
# entirely, so a large still is no longer re-encoded to fit and the
# RUNPOD_INLINE_* fallbacks above stop applying to anything that takes this
# path.
#
# Set all three to enable; leave any unset to keep inlining as before. The
# endpoint is the bucket URL in path style, the same value as BUCKET_ENDPOINT_URL
# on the RunPod worker template -- the worker already writes its *outputs* to
# such a bucket, and pointing inputs at the same one needs no new account.
# Region is "auto" for Cloudflare R2; AWS S3 needs its real region.
#
# Do NOT also add these to backend/ecosystem.config.cjs. src/env.ts only fills
# keys that process.env does not already define, so a `process.env.X || ""` line
# there would shadow the value here with an empty string and silently put every
# input back on the inline path.
# RUNPOD_INPUT_BUCKET_ENDPOINT_URL=https://<account>.r2.cloudflarestorage.com/<bucket>
# RUNPOD_INPUT_BUCKET_ACCESS_KEY_ID=
# RUNPOD_INPUT_BUCKET_SECRET_ACCESS_KEY=
# RUNPOD_INPUT_BUCKET_REGION=auto
# Objects are keyed <prefix>/<YYYY-MM>/<fingerprint><ext>, so the month segment
# gives a lifecycle rule something to expire. Inputs are re-uploaded only when a
# file's size or mtime changes, so the bucket will not grow per submission.
# RUNPOD_INPUT_BUCKET_PREFIX=momi-inputs

# Media access tokens. <img src>/<video src> cannot send an Authorization header,
# so media URLs carry a credential in the query string. That credential is a
# short-lived, media-read-only token -- never the session token, which would put
# a 14-day full-account credential into access logs and Referer headers.
# The secret must be the same on every api worker and stable across restarts, or
# a token minted by one worker fails on the next request that lands elsewhere.
# Unset, it is derived from the RunPod signing secret, so a correctly configured
# production host needs nothing here. With no RunPod config at all it falls back
# to a random per-process value (fine for a dev monolith; refused for split roles).
# MEDIA_ACCESS_TOKEN_SECRET=
# MEDIA_ACCESS_TOKEN_TTL_MS=1800000

# Optional comma-separated emails that can sign in for viewing only.
# Built-in demo identifiers also include demo@brickvisual.com and momi.demo@brickvisual.com.
# MOMI_DEMO_EMAILS=client.demo@brickvisual.com

# Serverless-compatible Comfy workflow JSON files.
SERVERLESS_WORKFLOW_ROOT=C:\Momi-Animation\workflow
# Optional override for all workflow roots, separated with semicolons on Windows.
# WORKFLOW_ROOTS=C:\Momi-Animation\workflow

# Optional text/image prompt helper endpoint. This must be a text-returning worker,
# not the serverless Comfy generation worker above.
# PROMPT_RUNPOD_ENDPOINT_ID=your-text-helper-runpod-endpoint-id
# PROMPT_RUNPOD_API_KEY=your-text-helper-runpod-api-key

# Seedance 2.0 keeps using the existing Comfy RunPod prompt workflow. Seedance 2.5
# and 2.5 Draft use the pinned sd25-pe skill with Claude through Comfy Router,
# authenticated by COMFY_ORG_API_KEY above.
# SEEDANCE_PROMPT_WORKFLOW_PATH=C:\Momi-Animation\workflow\prompt_generation\Seedance_prompt_generation.json
# SEEDANCE_PROMPT_OPENAI_MODEL=gpt5.5-pro
# SEEDANCE_25_PROMPT_SKILL_PATH=C:\Momi-Animation\workflow\prompt_generation\skills\sd25-pe\SKILL.md
# SEEDANCE_PROMPT_ROUTER_MODEL=anthropic/claude-opus-5-5
# SEEDANCE_PROMPT_ROUTER_MAX_TOKENS=4096

# Optional Kling image-to-video prompt-generation workflow overrides. By default this runs
# workflow/prompt_generation/Kling_image_to_video_prompt_generation.json on the main Comfy RunPod worker.
# KLING_PROMPT_WORKFLOW_PATH=C:\Momi-Animation\workflow\prompt_generation\Kling_image_to_video_prompt_generation.json
# KLING_PROMPT_SKILL_PATH=C:\Momi-Animation\workflow\prompt_generation\Kling_image_to_video_skill.md
# KLING_PROMPT_OPENAI_MODEL=gpt5.5-pro

# Optional local ComfyUI development settings.
# GENERATION_BACKEND=local_comfy
# COMFY_SERVERS=http://127.0.0.1:8201,http://127.0.0.1:8202
# COMFY_ROOT=C:\ComfyUI_windows_portable_nvidia_cu128\ComfyUI_windows_portable\ComfyUI
# COMFY_POOL_ROOT=C:\Comfy_pool

# Optional Credit Tracker sync target for serverless jobs.
# Defaults to the main local ComfyUI dashboard at http://127.0.0.1:8188, then falls back to COMFY_SERVERS.
# CREDIT_TRACKER_URLS=http://127.0.0.1:8188
# CREDIT_TRACKER_SYNC_TOKEN=optional-shared-token
# Off by default because shared Comfy/company balances can move from other users or parallel jobs.
# Enable only when this app is the only process spending the configured company credits.
# CREDIT_BALANCE_DELTA_ACCOUNTING=exclusive

# Frontend, only needed when the API is not served through the Vite /api proxy.
# VITE_API_BASE_URL=http://127.0.0.1:3333
